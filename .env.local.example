# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Your Resend API key. Get a free one at https://resend.com
# (Sign up -> Dashboard -> API Keys -> Create API Key)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where every application (with resume attached) gets delivered.
APPLICATIONS_TO_EMAIL=webloom.in00@gmail.com

# Optional: the "From" address shown on the email. Leave this as-is unless
# you've verified your own domain on Resend (see README).
# RESEND_FROM_EMAIL=PostHire Careers <onboarding@resend.dev>
